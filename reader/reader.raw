## 附录 B：完整伪代码（按调用顺序）

```text
// 1. 设置快照
cfg = PaibanConfig(
    fontSize, lineSpacing, paragraphSpacing, wordSpacing, fontWeight,
    headIndent, title*, margins, doubleColumn, bottomSlack=20,
    fontFamily=自带字体, naturalLineRatio=构建期标定值)

// 2. 页面几何
l,r,t,b = cfg.margins
if cfg.doubleColumn:
    colW = max(screenW*0.5 - l - r, 100)
    pageH = max(textViewH - cfg.bottomSlack, 100)
    // 左栏 x=l；右栏 x=screenW*0.5+l
else:
    colW = max(screenW - l - r, 100)
    pageH = max(textViewH - cfg.bottomSlack, 100)

// 3. 文本归一化
norm = normalizeChapter(rawText)
// norm.paragraphs 不含缩进；norm.sourceText = paragraphs.join('\n')

// 4. 构建块
inputs = []
if title non-empty:
    inputs.add(titleBlock(title, gapAfter=cfg.paragraphSpacing))
for each para in norm.paragraphs:
    inputs.add(bodyBlock(text=U+3000*headIndent + para,
                         sourceStart=..., sourceEnd=...,
                         gapAfter=cfg.paragraphSpacing))

// 5. 逐块 layout（每块只做一次）
y = backwardMode ? 2*(titleLineH+titleParaSpacing) : 0
allLines = []
for each input in inputs:
    style = input.isTitle ? titleStyle(cfg) : bodyStyle(cfg)
    tp = TextPainter(... cfg, strut, no scaling, zh_CN, justify ...)
         ..layout(maxWidth=colW)
    lines = []
    local = 0
    for m in tp.computeLineMetrics():
        r = tp.getLineBoundary(local)
        lineStart, lineEnd = r.start, r.end
        if lineEnd <= lineStart: lineEnd = min(local+1, text.length)
        lines.add(LineInfo(
            blockCharStart=lineStart, blockCharEnd=lineEnd,
            sourceStart=mapSource(lineStart), sourceEnd=mapSource(lineEnd),
            topRel=m.baseline - m.ascent, height=m.height))
        local = lineEnd
    block = BlockLayout(tp, topAbs=y, height=tp.height, lines)
    allLines += lines
    y += tp.height + input.gapAfter

// 6. 装页（单栏）
cols = []
i = 0
while i < allLines.length:
    pageTop = (i == 0) ? 0.0 : allLines[i].topAbs
    j = i
    while j < allLines.length:
        bottom = allLines[j].topAbs + allLines[j].height
        if j > i and bottom - pageTop > pageH + eps: break
        j++
    if j == i: j = i + 1
    cols.add(ColumnSlice(topAbs=pageTop, height=pageH,
                         firstLine=i, lastLine=j,
                         sourceStart=allLines[i].sourceStart,
                         sourceEnd=allLines[j-1].sourceEnd))
    i = j

// 7. 双栏
// cols 已经是按半栏宽分出的“栏”；物理页 = (cols[2k], cols[2k+1])

// 8. 绘制
for each block intersecting current col:
    canvas.save()
    canvas.clipRect(colRect)
    dy = colRect.top + (block.topAbs - col.topAbs)
    canvas.translate(colRect.left, dy)
    block.painter.paint(canvas, Offset.zero)
    canvas.restore()

// 9. 进度
sourceOffset = currentCol.sourceStart
column = first col with sourceEnd > sourceOffset
```

